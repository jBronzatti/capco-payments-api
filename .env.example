# Copy to .env (never commit .env). Placeholders only.

# Used by `npm run start:dev` / `npm run migrate:deploy` on the host.
# docker compose overrides it to point at its own database service.
DATABASE_URL=postgresql://payments:payments@localhost:5432/payments

# Comma-separated `id:sha256(key)` entries; append `:settle` to allow manual PIX status changes.
# Generate real keys with: npm run key:generate -- <id> [--settle]
# The entry below is the PUBLISHED demo key `demo-key-local-pix-testing-only`. The API accepts it
# only while DEMO_MODE=true and card payments are NOT configured. Never expose it beyond localhost.
# To enable card payments, replace it with a generated key.
API_KEYS=demo:333f639ff410ce6214a1d88b7b176d0ceda84d5e25e652c16ce5f0f14b5a6406:settle
DEMO_MODE=true

MAX_AMOUNT_CENTS=100000000
LOG_LEVEL=info
PORT=3000

# Card payments (Mercado Pago Checkout Pro). All three or none; leave empty for a PIX-only run.
# Use TEST credentials from your application's "Credenciais de teste". Never paste them anywhere else.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Numeric Mercado Pago user id that owns the credentials (`npm run mp:probe` prints it).
MP_COLLECTOR_ID=
CHECKOUT_TTL_MINUTES=30
MP_REQUEST_TIMEOUT_MS=8000
# Set to true in any deployment meant to serve card payments: boot fails without the variables above.
REQUIRE_CARD_PAYMENTS=false
